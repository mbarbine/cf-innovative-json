# Shared, build-time, nonsecret. One of: development, test, production.
NODE_ENV=development

# Local-only, runtime, nonsecret.
PORT=3000

# Optional, shared runtime secrets. Persistence is degraded when absent.
DATABASE_URL=
REDIS_URL=

# Optional/legacy, shared runtime nonsecret base URL for external API consumers.
API_BASE_URL=

# Shared deployment contract. Values below describe local development.
DEPLOYMENT_PROVIDER=local
DEPLOYMENT_ENVIRONMENT=development
PLATPHORM_CANARY=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_URL=https://json.platphormnews.com
PLATPHORM_TRACE_BASE_URL=https://trace.platphormnews.com
PLATPHORM_REQUIRE_API_KEY=false

# Optional shared runtime secret. Provision through the hosting provider; never commit it.
PLATPHORM_API_KEY=

# Optional shared runtime model integration secrets.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

